debug() {
    dotnet watch --project "src/$1" --hot-reload --non-interactive
}

# Completion: only folders containing a .csproj file
_debug_projects() {
    local projects
    projects=()

    for d in src/*; do
        if [[ -d "$d" ]]; then
            # Check for .csproj file
            if ls "$d"/*.csproj >/dev/null 2>&1; then
                projects+=("${d:t}")   # folder name only, with original casing
            fi
        fi
    done

    _describe 'project' projects
}

compdef _debug_projects debug
