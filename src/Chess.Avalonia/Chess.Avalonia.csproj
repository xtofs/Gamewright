<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image the chess frames name, shared with the browser host. -->
    <AvaloniaResource Include="../Chess.Browser/wwwroot/sprites.png" Link="sprites.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gamewright.Avalonia/Gamewright.Avalonia.csproj" />
    <ProjectReference Include="../Chess/Chess.csproj" />
  </ItemGroup>

</Project>
