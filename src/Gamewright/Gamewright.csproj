<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Gamewright</AssemblyName>
    <RootNamespace>Gamewright</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <ItemGroup>
    <ShaderSource Include="Shaders/**/*.glsl;Shaders/**/*.vert;Shaders/**/*.frag;Shaders/shaders.json" />
    <ShaderGeneratorSource Include="../CodeGen/**/*.cs" Exclude="../CodeGen/bin/**;../CodeGen/obj/**" />
    <Compile Include="$(IntermediateOutputPath)Generated/ShaderBindings.g.cs" />
  </ItemGroup>

  <Target Name="GenerateShaderBindings" BeforeTargets="CoreCompile">
    <MSBuild Projects="../CodeGen/CodeGen.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <Exec Command="dotnet &quot;../CodeGen/bin/$(Configuration)/net10.0/CodeGen.dll&quot; &quot;$(MSBuildProjectDirectory)/Shaders/shaders.json&quot; &quot;$(IntermediateOutputPath)Generated&quot;" />
  </Target>

</Project>