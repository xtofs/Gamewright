<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Gamewright.Graphics</AssemblyName>
    <RootNamespace>Gamewright.Graphics</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <ItemGroup>
    <ShaderSource Include="Shaders/**/*.glsl;Shaders/**/*.vert;Shaders/**/*.frag;Shaders/shaders.json" />
    <!-- build order only: CodeGen runs as a tool, its assembly is not referenced -->
    <ProjectReference Include="../CodeGen/CodeGen.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Regenerates Generated/ShaderBindings.g.cs, which is checked in so the IDE and a fresh clone
    always see it. Skipped in design-time builds (VS Code / IntelliSense) and whenever neither
    a shader nor CodeGen changed since the last generation.
  -->
  <PropertyGroup>
    <ShaderBindingsFile>$(MSBuildProjectDirectory)/Generated/ShaderBindings.g.cs</ShaderBindingsFile>
  </PropertyGroup>

  <Target Name="ResolveCodeGen">
    <MSBuild Projects="../CodeGen/CodeGen.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="CodeGenAssembly" />
    </MSBuild>
  </Target>

  <Target Name="GenerateShaderBindings" BeforeTargets="CoreCompile" DependsOnTargets="ResolveCodeGen"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(ShaderSource);$(CodeGenAssembly)" Outputs="$(ShaderBindingsFile)">
    <Exec Command="dotnet &quot;$(CodeGenAssembly)&quot; &quot;$(MSBuildProjectDirectory)/Shaders/shaders.json&quot; &quot;$(MSBuildProjectDirectory)/Generated&quot;" />
    <Touch Files="$(ShaderBindingsFile)" />
  </Target>

</Project>