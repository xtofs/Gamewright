<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image the Havannah frames name, shared with the browser host. -->
    <AvaloniaResource Include="../Havannah.Browser/wwwroot/pieces-spritesheet.png" Link="pieces-spritesheet.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gamewright.Avalonia/Gamewright.Avalonia.csproj" />
    <ProjectReference Include="../Havannah/Havannah.csproj" />
  </ItemGroup>

</Project>
