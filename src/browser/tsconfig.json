{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "outDir": "wwwroot",
    "rootDir": "wwwroot"
  },
  "include": ["wwwroot/main.ts", "types/**/*.d.ts"],
  "exclude": []
}
